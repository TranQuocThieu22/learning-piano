# Giải thích đầy đủ từng biến: docs/_internal/bien-moi-truong.md

# --- Database ---
# Postgres connection string. Works with Neon, Vercel Postgres, Supabase, Railway, ...
# Get one free at https://neon.com or from the Vercel dashboard (Storage -> Postgres).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Chuỗi kết nối trực tiếp (không qua pooler), chỉ drizzle-kit dùng khi đổi cấu trúc
# bảng — chạy ổn định hơn ngoài pooler. Thiếu thì tự lùi về DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# Hai biến dưới đây KHÔNG tự điền — tích hợp Neon trên Vercel tự bơm chúng vào khi
# chạy `vercel env pull`, cùng hàng chục biến `PG*`/`POSTGRES_*`/`NEON_*` khác mà
# ứng dụng không đọc (xem bẫy 8 trong docs/_internal/bay-ky-thuat.md).
#
# Đúng hai biến này có được dùng: `scripts/baseline-migrations.mjs --prod` lấy
# chúng để trỏ vào nhánh production, khỏi phải dán chuỗi kết nối kèm mật khẩu vào
# dòng lệnh. Ưu tiên bản không qua pooler vì lệnh đổi cấu trúc bảng chạy ổn định hơn.
# POSTGRES_URL_NON_POOLING=""
# POSTGRES_URL=""

# --- Auth.js (NextAuth) ---
# Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <your-app-url>/api/auth/callback/google
# (for local dev that's http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Quản trị ---
# Email được vào /admin, ngăn nhau bằng dấu phẩy. Đọc từ đây chứ không từ database
# để người chiếm được quyền ghi database vẫn không tự phong mình làm admin.
# ĐỂ TRỐNG NGHĨA LÀ KHÔNG AI VÀO ĐƯỢC — đó là hành vi cố ý.
ADMIN_EMAILS=""

# --- Thanh toán: VietQR + webhook đối soát của SePay ---
# Tiền vào thẳng tài khoản ngân hàng của bạn, SePay chỉ báo về khi có giao dịch.

# Khoá bí mật để xác thực webhook. Tự nghĩ ra một chuỗi ngẫu nhiên dài (ví dụ
# `openssl rand -hex 32`), dán y hệt vào SePay ở mục Webhooks với kiểu xác thực
# API Key. Không có biến này thì endpoint webhook từ chối mọi yêu cầu.
# ĐÂY LÀ THỨ DUY NHẤT NGĂN NGƯỜI LẠ TỰ CẤP GÓI TRẢ PHÍ CHO HỌ — đừng commit.
SEPAY_WEBHOOK_API_KEY=""

# Thông tin tài khoản nhận tiền, dùng để dựng mã VietQR hiển thị cho người học.
# Mã ngân hàng tra ở https://api.vietqr.io/v2/banks (ví dụ: MBBank, Vietcombank, ACB)
SEPAY_BANK_CODE=""
SEPAY_ACCOUNT_NUMBER=""
SEPAY_ACCOUNT_NAME=""

# Địa chỉ để scripts/test-webhook.mjs bắn webhook giả vào khi chạy thử.
# Mặc định http://localhost:3000, không cần đặt trên Vercel.
# TEST_BASE_URL=""
